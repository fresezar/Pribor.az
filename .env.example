# ---------------------------------------------------------------
# Pribor — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env  (değerleri doldur, .env asla commit edilmez)
# ---------------------------------------------------------------

# PostgreSQL (docker-compose.yml ile birebir uyumlu)
DATABASE_URL=postgres://pribor:pribor_dev@localhost:5432/pribor

# Redis (cache + BullMQ + Streams)
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=pribor_dev_master_key

# ML servisi (FastAPI) — NestJS bu adrese proxy'ler
ML_SERVICE_URL=http://localhost:8100

# Nesne depolama — lokalde MinIO, prod'da Cloudflare R2
# (R2 için: endpoint https://<account_id>.r2.cloudflarestorage.com)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=pribor
S3_SECRET_ACCESS_KEY=pribor_dev_secret
S3_BUCKET_RAW=pribor-raw
S3_REGION=auto

# SMS OTP sağlayıcısı (yerel agregator — Faz 1'de doldurulacak)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Uygulama
API_PORT=3001
WEB_URL=http://localhost:3000

# Yönetici email'leri (virgülle ayrık, küçük harf). Bu email'lerle giriş yapan
# kullanıcı otomatik admin olur (sınırsız ilan + silme/satıldı) — rol asla
# istemciden alınmaz. Kendini admin yapmak için buraya email'ini ekle + yeniden giriş.
ADMIN_EMAILS=admin@pribor.az

# --- Email (OTP giriş kodu) ---
# SMTP boşsa: kod gönderilmez, konsola loglanır ve non-prod'da ekranda gösterilir.
# Prod'da giriş için bunları doldur (Gmail örneği: app password üret).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pribor <no-reply@pribor.az>

# Web'de gösterilen destek/WhatsApp numarası (admin iletişim köşesi)
NEXT_PUBLIC_SUPPORT_PHONE=+994555000001

# --- Prod ---
# Tarayıcının ulaşacağı API adresi (build zamanı gömülür — mutlaka public URL)
NEXT_PUBLIC_API_URL=http://localhost:3001
# CORS izinli origin'ler (virgülle ayrık) — prod'da web'in gerçek domain'i
CORS_ORIGINS=http://localhost:3000
